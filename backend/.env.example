# ----------------------------------------------------
# BACKEND ENVIRONMENT VARIABLES
# Copy this file to .env and fill in the values below
# ----------------------------------------------------

# Express Server Port (Default is usually 8000)
PORT=8000

# Your Supabase Project URL (e.g. https://xyz.supabase.co)
SUPABASE_URL=your-supabase-project-url

# Your Supabase Project Anon/Public Key
SUPABASE_ANON_KEY=your-supabase-anon-key

# The URL of your Vercel Frontend (Used for CORS restrictions)
# For local development: http://localhost:5173
# For production: https://your-vercel-app.vercel.app
FRONTEND_URL=http://localhost:5173

# Set to "development" for local machines, and "production" on Render
NODE_ENV=development
