SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
FRONTEND_URL=https://your-frontend-domain.vercel.app
NODE_ENV=production
PORT=8000

# MCQ Engine Database Settings
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/digital_microsys?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=7d
CLIENT_URL=https://your-frontend-domain.vercel.app
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Admin Seed Settings (Optional)
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=YourSecurePassword123!
ADMIN_USERNAME=admin

# Internal Gateway Auth
GATEWAY_SECRET=your_super_secret_gateway_key
